# Copy to .env.local for local dev. Set the same values in Vercel for production.

# Postgres connection string (required). Locally: postgres://user:pass@localhost:5432/zerostim
DATABASE_URL=

# Long random string used to sign login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# App manager login at /admin (not linked anywhere in the app).
ADMIN_PASSWORD=

# One-time: when the database is first upgraded to multiple families, the original
# family gets a parent login with this email and PARENT_PASSWORD.
OWNER_EMAIL=
PARENT_PASSWORD=

# Time zone used to decide what "today" and "this week" are.
FAMILY_TZ=America/New_York
