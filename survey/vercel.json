{
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/survey/", "permanent": false },
    { "source": "/(overview|scroll|focused)/:path*", "destination": "/survey/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/survey", "destination": "/index.html" },
    { "source": "/survey/", "destination": "/index.html" },
    { "source": "/survey/:path+", "destination": "/:path+" }
  ]
}
